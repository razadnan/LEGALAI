# Copy this structure into Streamlit Cloud → Settings → Secrets
# DO NOT commit the real secrets.toml — it's already in .gitignore

GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.5-flash"
LLM_PROVIDER = "auto"
EMBEDDING_PROVIDER = "auto"
EMBEDDING_MODEL = "gemini-embedding-001"
MAX_UPLOAD_MB = "20"
